{
  "name": "@immediately-run/cli",
  "version": "0.8.1",
  "description": "Command-line tools for immediately.run: build a pre-cached repository zip (with a contribute manifest sidecar) for fast, rate-limit-free loading, and pin UI release locks for the region registry.",
  "type": "module",
  "license": "MIT",
  "author": "immediately.run",
  "homepage": "https://github.com/immediately-run/immediately-run-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/immediately-run-cli.git"
  },
  "bugs": {
    "url": "https://github.com/immediately-run/immediately-run-cli/issues"
  },
  "keywords": [
    "immediately.run",
    "cli",
    "cache",
    "zip",
    "github"
  ],
  "bin": {
    "immediately-run": "./dist/cli.js",
    "immediately.run": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check:sidecar": "node scripts/check-sidecar-literal.mjs",
    "test": "npm run build && npm run check:sidecar && node --test test/*.test.mjs",
    "verify": "npm test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@immediately-run/platform-constants": "0.2.0",
    "@immediately-run/transpiler": "^0.5.0",
    "@msgpack/msgpack": "^3.1.3"
  }
}
